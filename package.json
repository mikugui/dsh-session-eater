{
  "name": "dsh-session-eater",
  "version": "0.6.0",
  "description": "会话清理（喂鱼）：把不要的会话拖到侧栏底部的小胖鱼嘴边，它张嘴吃掉 —— 目录移入回收站、可撤销；删除前会问一句并写出这条会话烧掉多少 token，点图标直达设置，17 段界面文案可自定义。（DSH Web 插件）",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "cleanup",
    "trash",
    "whale",
    "balance-widget"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test:host": "node tests/verify-host.mjs",
    "test:client": "node tests/verify-client.mjs",
    "test:settings": "node tests/verify-settings.mjs",
    "inspect": "node tests/inspect-sessions.mjs",
    "filmstrip": "node tests/filmstrip.mjs 10",
    "test:market": "node tests/verify-market-entry.mjs",
    "submit:market": "node scripts/submit-market.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikugui/dsh-session-eater.git"
  },
  "homepage": "https://github.com/mikugui/dsh-session-eater#readme",
  "bugs": {
    "url": "https://github.com/mikugui/dsh-session-eater/issues"
  },
  "license": "MIT"
}
